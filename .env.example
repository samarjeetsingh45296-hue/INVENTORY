# ============================================================================
#  INVENTORY SUITE - environment template
#  Copy to `.env` and fill in. NEVER commit the real `.env`.
# ============================================================================

NODE_ENV=development
TZ=Asia/Kolkata

# ---------------------------------------------------------------- database --
# The MASTER source of truth. Everything lives here permanently.
POSTGRES_USER=inventory
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=inventory
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL="postgresql://inventory:change-me-strong-password@localhost:5432/inventory?schema=public"

# ------------------------------------------------------------------- redis --
# Cache + BullMQ queues (scheduled sync, nightly backup, notifications)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL="redis://localhost:6379"

# -------------------------------------------------------------------- auth --
# Generate with:  openssl rand -hex 64
JWT_ACCESS_SECRET=replace-with-64-byte-random-hex
JWT_REFRESH_SECRET=replace-with-a-different-64-byte-random-hex
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# AES-256-GCM key for encrypting MFA secrets at rest. openssl rand -hex 32
ENCRYPTION_KEY=replace-with-32-byte-random-hex
MFA_ISSUER="Inventory Suite"
MFA_REQUIRED_ROLES=SUPER_ADMIN,HR_ADMIN
PASSWORD_MIN_LENGTH=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
SESSION_IDLE_TIMEOUT_MINUTES=60

# --------------------------------------------------------------------- api --
API_PORT=4000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=300
TRUST_PROXY=true

# --------------------------------------------------------------------- web --
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME="Inventory Suite"

# ----------------------------------------------------- google sheets (sync) --
# OPTIONAL. The system runs fully without this - Sheets are import-only.
# Create a Google Cloud service account, enable the Google Sheets API,
# download the JSON key, and SHARE each sheet with the service account email
# as *Viewer* (read-only - the system never writes back to your sheets).
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/google-service-account.json
GOOGLE_SHEETS_READONLY=true

# Workbook A - Wing Wise Inventory
SHEET_WINGWISE_ID=1O193Lz3kiSpzzflOYKC6XBeJuSmLeoEg8AoEtXdaOhI
# Workbook B - Central Contact Center Inventory
SHEET_CONTACT_CENTER_ID=1cs1XPfTMumbQ2VrTbAo-OXUrVFba2jSyPSlWyTGHoFc

# Scheduled sync: OFF | HOURLY | SIX_HOURLY | DAILY
SYNC_SCHEDULE=OFF
SYNC_DAILY_AT_CRON="0 2 * * *"
# Safety rail: a sync run that would touch more than this many rows pauses
# for admin confirmation instead of applying blindly.
SYNC_MAX_ROWS_PER_RUN=20000

# ------------------------------------------------------------------ backup --
BACKUP_DIR=./backups
BACKUP_DAILY_CRON="0 1 * * *"
BACKUP_WEEKLY_CRON="0 3 * * 0"
BACKUP_DAILY_RETENTION=90
BACKUP_WEEKLY_RETENTION=52
PG_DUMP_PATH=pg_dump

# ----------------------------------------------------------------- storage --
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------- email --
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Inventory Suite <no-reply@example.com>"

# ------------------------------------------------------------------ seeding --
SEED_SUPER_ADMIN_EMAIL=digitalmarketing@paruluniversity.ac.in
SEED_SUPER_ADMIN_NAME="Super Admin"
# If blank, the seed script generates a strong password and prints it ONCE.
SEED_SUPER_ADMIN_PASSWORD=
