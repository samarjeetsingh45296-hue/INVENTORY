{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": ".",
    // @inventory/shared deliberately has no path mapping: it resolves through
    // the pnpm workspace link to packages/shared/dist, which keeps it inside
    // this project's rootDir. Build the shared package before the API.
    "paths": {
      "src/*": ["src/*"]
    },
    "strictPropertyInitialization": false
  },
  "include": ["src/**/*.ts", "prisma/**/*.ts", "scripts/**/*.ts"]
}
