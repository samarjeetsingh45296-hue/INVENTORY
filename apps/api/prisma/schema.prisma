  startedAt   DateTime?
  completedAt DateTime?
  /// PLANNED | IN_PROGRESS | COMPLETED | ABANDONED
  status      String   @default("PLANNED")
  conductedById String? @db.Uuid
  summary     Json     @default("{}")

  lines       PhysicalAuditLine[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid
  deletedById String?  @db.Uuid

  @@map("physical_audits")
}

model PhysicalAuditLine {
  id          String   @id @default(uuid()) @db.Uuid
  auditId     String   @db.Uuid
  audit       PhysicalAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
