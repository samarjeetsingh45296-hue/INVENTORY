  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)

  expectedLocationId String? @db.Uuid
  foundLocationId    String? @db.Uuid
  /// PENDING | VERIFIED | MISPLACED | MISSING | EXTRA | DAMAGED
  finding     String   @default("PENDING")
  scannedAt   DateTime?
  scannedById String?  @db.Uuid
  conditionFound AssetCondition?
