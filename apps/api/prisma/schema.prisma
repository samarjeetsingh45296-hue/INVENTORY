// ============================================================================
//  INVENTORY SUITE - master schema
//
//  GOVERNING RULE: this database is the permanent source of truth.
//  Google Sheets are an *import surface* only. Nothing here is ever deleted
//  as a side effect of a sheet being deleted, renamed or emptied; the sync
//  engine is strictly additive/uppdating and never issues deletes.
//
//  Conventions used throughout:
//    * uuid primary keys           - safe to merge across branches/offices
//    * deletedAt / deletedById     - soft delete; nothing is physically removed
//    * createdById / updatedById   - who touched the row
//    * sourceType / sourceRef      - provenance of every imported row
//    * *_history / *Event tables   - append-only, never updated or deleted
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, pg_trgm, unaccent]
}

