  @@map("system_settings")
}

// ---------------------------------------------------------------------------
//  GOOGLE SHEET SYNC
//
//  Read-only, additive, and entirely optional. Three modes are supported:
//    MANUAL              - admin presses "Sync Google Sheet"
//    SCHEDULED           - hourly / 6-hourly / daily
//    ONE_TIME_MIGRATION  - import once, then disconnect for good
//
//  The engine NEVER deletes or deactivates a database row because a sheet row
//  vanished. A sheet going missing is a source outage, not a business event.
//  Every raw row ever read is archived in `sync_rows`, so the original sheet
//  content survives even if the spreadsheet itself is destroyed.
// ---------------------------------------------------------------------------

model SyncSource {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  sourceType     SourceType @default(GOOGLE_SHEET)

  /// Google workbook id + tab. Null for uploaded Excel/CSV sources.
  spreadsheetId  String?
  sheetGid       String?
  sheetName      String?
  workbookLabel  String?

  /// Which master table rows from this tab become.
  targetEntity   String
  /// 1-based row holding the column headers; data starts on the next row.
  headerRow      Int      @default(1)
  /// Field names (post-mapping) that together identify a row uniquely.
  /// e.g. ["serialNumber"] or ["employeeCode"] or ["mobileNumber"].
  dedupeKeys     String[] @default([])

  mode           SyncMode     @default(MANUAL)
  schedule       SyncSchedule @default(OFF)
  /// Set true by a ONE_TIME_MIGRATION, or manually via "Disconnect".
  /// A disconnected source can never run again without an explicit reconnect.
  isDisconnected Boolean  @default(false)
  disconnectedAt DateTime?
  disconnectedById String? @db.Uuid

  /// When true a run only reports what it *would* do and writes nothing.
  dryRunDefault  Boolean  @default(false)
  /// Update rows that already exist, or only insert brand-new ones.
  allowUpdates   Boolean  @default(true)

  lastRunAt      DateTime?
  lastSuccessAt  DateTime?
  lastRowCount   Int?
  lastError      String?

  mappings       SyncColumnMapping[]
  runs           SyncRun[]

  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?
  createdById    String?  @db.Uuid
  updatedById    String?  @db.Uuid
  deletedById    String?  @db.Uuid

  @@unique([spreadsheetId, sheetGid])
  @@index([targetEntity])
  @@map("sync_sources")
}

/// Maps a spreadsheet column header onto a field of the target entity.
/// Editable from the admin UI, so a renamed column is a 10-second fix rather
/// than a code change.
model SyncColumnMapping {
  id           String  @id @default(uuid()) @db.Uuid
  sourceId     String  @db.Uuid
  source       SyncSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  /// Header exactly as it appears in the sheet.
  sourceHeader String
  /// Dotted path on the target entity, e.g. "employee.employeeCode".
  targetField  String
  /// none | trim | upper | lower | title | date | number | boolean | phone |
  /// enum | lookup - applied by the transform pipeline.
  transform    String  @default("trim")
  transformArg Json    @default("{}")
  isRequired   Boolean @default(false)
  defaultValue String?
  /// Ignore this column entirely (kept for documentation).
  isIgnored    Boolean @default(false)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([sourceId, sourceHeader])
  @@map("sync_column_mappings")
}

model SyncRun {
  id            String   @id @default(uuid()) @db.Uuid
  sourceId      String   @db.Uuid
  source        SyncSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  mode          SyncMode
  status        SyncStatus @default(PENDING)
  dryRun        Boolean  @default(false)

  triggeredById String?  @db.Uuid
  triggeredByName String?
  startedAt     DateTime @default(now())
  finishedAt    DateTime?
  durationMs    Int?

  rowsRead      Int @default(0)
  rowsNew       Int @default(0)
  rowsUpdated   Int @default(0)
  rowsUnchanged Int @default(0)
  rowsDuplicate Int @default(0)
  rowsInvalid   Int @default(0)
  rowsConflict  Int @default(0)
  rowsSkipped   Int @default(0)

  /// Populated when a run exceeds SYNC_MAX_ROWS_PER_RUN and pauses for an
  /// admin to confirm rather than applying a huge change blindly.
  confirmationToken String?
  confirmedById String?  @db.Uuid
  confirmedAt   DateTime?

  errorMessage  String?
  errorDetail   Json?
  /// Backup taken immediately before a ONE_TIME_MIGRATION or a large run.
  preRunBackupId String? @db.Uuid

  rows          SyncRow[]

  createdAt     DateTime @default(now())

  @@index([sourceId, startedAt])
  @@index([status])
  @@map("sync_runs")
}

/// Permanent archive of every row ever read from a sheet, exactly as it was
/// read. This is what guarantees that deleting the Google Sheet costs nothing:
/// the raw source data is already inside the master database.
model SyncRow {
  id          BigInt   @id @default(autoincrement())
  runId       String   @db.Uuid
  run         SyncRun  @relation(fields: [runId], references: [id], onDelete: Cascade)

  rowNumber   Int
  /// Verbatim cell values keyed by sheet header.
  rawData     Json
  /// Values after mapping, transformation and validation.
  normalized  Json?
  /// Hash of rawData - lets an unchanged row be detected without comparison.
  rowHash     String
  dedupeKey   String?

  status      SyncRowStatus
  entityType  String?
  entityId    String?  @db.Uuid
  /// Validation errors / conflict explanations shown in the sync report.
  messages    Json     @default("[]")

  createdAt   DateTime @default(now())

  @@index([runId, status])
  @@index([dedupeKey])
  @@index([rowHash])
  @@map("sync_rows")
}

// ---------------------------------------------------------------------------
//  BACKUPS
// ---------------------------------------------------------------------------

model BackupRun {
  id           String   @id @default(uuid()) @db.Uuid
  type         BackupType
  format       BackupFormat @default(PG_DUMP)
  status       BackupStatus @default(RUNNING)

  startedAt    DateTime @default(now())
  finishedAt   DateTime?
  durationMs   Int?

  filePath     String?
  fileName     String?
  sizeBytes    BigInt?
  checksumSha256 String?

  /// Rows per table at the moment of the dump - a cheap integrity signal and
  /// proof that nothing silently disappeared between backups.
  tableCounts  Json     @default("{}")

  /// Daily backups keep the newest 90; weekly archives keep 52.
  retainUntil  DateTime?
  prunedAt     DateTime?

  triggeredById String? @db.Uuid
  triggeredByName String?
  errorMessage String?

  createdAt    DateTime @default(now())

  @@index([type, startedAt])
  @@index([status])
  @@map("backup_runs")
}
