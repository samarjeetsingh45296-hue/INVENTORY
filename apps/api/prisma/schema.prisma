  @@map("physical_audit_lines")
}

// ---------------------------------------------------------------------------
//  AUDIT TRAIL  (mandatory - every change is captured here)
//  Append-only. A database trigger rejects UPDATE and DELETE on this table so
//  that not even a compromised application account can rewrite history.
// ---------------------------------------------------------------------------

model AuditLog {
  id          BigInt   @id @default(autoincrement())

  action      AuditAction
  entityType  String
  entityId    String?  @db.Uuid
  /// Human label captured at the time, e.g. "Laptop LPT-1001" - stays readable
  /// even if the row is later renamed.
  entityLabel String?

  /// Who
  userId      String?  @db.Uuid
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName    String
  userEmail   String?
  roleKeys    String[] @default([])

  /// Where from
  ipAddress   String?
  userAgent   String?
  requestId   String?
  sessionId   String?

  /// What changed - only the fields that actually differ.
  oldValue    Json?
  newValue    Json?
  changedFields String[] @default([])
  summary     String?

  /// Correlation: sync run, approval request, import batch...
  refType     String?
  refId       String?

  createdAt   DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model Attachment {
