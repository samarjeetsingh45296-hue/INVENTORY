// ============================================================================
//  NOTE ON ACTOR COLUMNS
//  createdById / updatedById / deletedById are stored as plain uuid scalars
//  rather than Prisma relations. Wiring a relation for each would require
//  ~150 back-references on User and make the model unusable. Referential
//  integrity for these columns is added at the database level in
//  migrations/manual/01_actor_fks.sql, and they are resolved in the API by
//  ActorResolverService. Business relations are always modelled properly.
// ============================================================================

// ---------------------------------------------------------------------------
//  ORGANISATION / LOCATION HIERARCHY
//  A tree, so new offices, branches, contact centres and wings can be added
//  forever without a schema change.
// ---------------------------------------------------------------------------

model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  legalName   String?
  logoUrl     String?
  settings    Json     @default("{}")

  branches    Branch[]
  departments Department[]

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid
  deletedById String?  @db.Uuid

  @@index([deletedAt])
  @@map("organizations")
}

model Branch {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  code           String
  name           String
  siteType       String   @default("CAMPUS")
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  country        String   @default("India")
  pincode        String?
  timezone       String   @default("Asia/Kolkata")

  locations      Location[]
  employees      Employee[]
  assets         Asset[]
  workstations   Workstation[]
  lockers        Locker[]
  cugConnections CugConnection[]
  stockItems     StockItem[]
  userScopes     UserScope[]

  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?
  createdById    String?  @db.Uuid
  updatedById    String?  @db.Uuid
  deletedById    String?  @db.Uuid

  @@unique([organizationId, code])
  @@index([deletedAt])
  @@map("branches")
}

/// Self-referencing tree: Campus / Building / Wing / Floor / Room / Zone.
/// The "Wing Wise Inventory" workbook maps onto nodes with kind = WING.
model Location {
  id          String   @id @default(uuid()) @db.Uuid
  branchId    String   @db.Uuid
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)

  parentId    String?  @db.Uuid
  parent      Location?  @relation("LocationTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Location[] @relation("LocationTree")

  kind        LocationKind
  code        String
  name        String
  /// Materialised path, e.g. "PU/ADMIN-BLOCK/A-WING/2F". Maintained by the
  /// service layer so subtree queries are one indexed prefix scan.
  path        String   @default("")
  depth       Int      @default(0)
  capacity    Int?
  notes       String?

  assets       Asset[]
  workstations Workstation[]
  lockers      Locker[]
  stockItems   StockItem[]

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid
  deletedById String?  @db.Uuid

  @@unique([branchId, code])
  @@index([path])
  @@index([parentId])
  @@index([kind])
  @@index([deletedAt])
  @@map("locations")
}

model Department {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  code           String
  name           String
  parentId       String?  @db.Uuid
  parent         Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: Restrict)
  children       Department[] @relation("DepartmentTree")

  employees      Employee[]
  assetRequests  AssetRequest[]

  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?
  createdById    String?  @db.Uuid
  updatedById    String?  @db.Uuid
  deletedById    String?  @db.Uuid

  @@unique([organizationId, code])
  @@index([deletedAt])
  @@map("departments")
}

model Designation {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  /// Lower number = more senior. Used to resolve the approval chain.
  grade       Int?

  employees   Employee[]

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid
  deletedById String?  @db.Uuid

  @@map("designations")
}

// ---------------------------------------------------------------------------
//  PEOPLE
// ---------------------------------------------------------------------------

model Employee {
  id               String   @id @default(uuid()) @db.Uuid
  /// Payroll / HRMS code. Unique per organisation and the natural key the
  /// sheet importer de-duplicates on.
  employeeCode     String
  organizationId   String   @db.Uuid

  firstName        String
  lastName         String?
  /// Denormalised for fast search; recomputed by the service layer.
  fullName         String
  officialEmail    String?
  personalEmail    String?
  phone            String?
  alternatePhone   String?
  gender           String?
  bloodGroup       String?
  dateOfBirth      DateTime? @db.Date
  dateOfJoining    DateTime? @db.Date
  dateOfLeaving    DateTime? @db.Date
  employmentStatus EmploymentStatus @default(ACTIVE)
  employmentType   String?

  branchId         String?  @db.Uuid
  branch           Branch?  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  departmentId     String?  @db.Uuid
  department       Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  designationId    String?  @db.Uuid
  designation      Designation? @relation(fields: [designationId], references: [id], onDelete: Restrict)

  reportingManagerId String?  @db.Uuid
  reportingManager   Employee?  @relation("EmployeeManager", fields: [reportingManagerId], references: [id], onDelete: Restrict)
  directReports      Employee[] @relation("EmployeeManager")

  /// Contact-centre specific, optional elsewhere.
  process          String?
  shift            String?
  seatNumber       String?

  photoUrl         String?
  address          String?
  remarks          String?

  user                   User?
  allocations            AssetAllocation[]
  workstationAllocations WorkstationAllocation[]
  lockerAllocations      LockerAllocation[]
  cugAllocations         CugAllocation[]
  repairsReported        RepairTicket[]  @relation("RepairReporter")
  assetRequests          AssetRequest[]
  damageReports          DamageReport[]

  /// Provenance: which workbook, tab and row this employee first arrived from.
  sourceType       SourceType @default(MANUAL)
  sourceRef        String?
  externalRefs     Json     @default("{}")

  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?
  createdById      String?  @db.Uuid
  updatedById      String?  @db.Uuid
  deletedById      String?  @db.Uuid

  @@unique([organizationId, employeeCode])
  @@index([fullName])
  @@index([officialEmail])
  @@index([phone])
  @@index([branchId, departmentId])
  @@index([employmentStatus])
  @@index([deletedAt])
  @@map("employees")
}

// ---------------------------------------------------------------------------
//  AUTH & RBAC
// ---------------------------------------------------------------------------

model User {
  id                 String   @id @default(uuid()) @db.Uuid
  email              String   @unique
  passwordHash       String
  displayName        String

  employeeId         String?  @unique @db.Uuid
  employee           Employee? @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  passwordChangedAt  DateTime?

  mfaEnabled         Boolean  @default(false)
  /// TOTP secret, AES-256-GCM encrypted at rest. Never leaves the server.
  mfaSecretEnc       String?
  /// Hashed single-use recovery codes.
  mfaRecoveryCodes   Json     @default("[]")

  lastLoginAt        DateTime?
  lastLoginIp        String?
  failedLoginCount   Int      @default(0)
  lockedUntil        DateTime?

  roles              UserRole[]
  scopes             UserScope[]
  refreshTokens      RefreshToken[]
  loginHistory       LoginHistory[]
  auditLogs          AuditLog[]
  notifications      Notification[]
  approvalDecisions  ApprovalStep[] @relation("ApprovalDecider")

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime?
  createdById        String?  @db.Uuid
  updatedById        String?  @db.Uuid
  deletedById        String?  @db.Uuid

  @@index([deletedAt])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  /// SUPER_ADMIN | HR_ADMIN | INVENTORY_MANAGER | TEAM_LEADER | EMPLOYEE
  key         String   @unique
  name        String
  description String?
  /// Lower = more powerful. Nobody may grant a role ranked at or above their own.
  rank        Int      @default(100)
  /// System roles cannot be renamed or removed, only re-permissioned.
  isSystem    Boolean  @default(false)

  permissions RolePermission[]
  users       UserRole[]

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid
  deletedById String?  @db.Uuid

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  /// Dot notation, e.g. "asset.allocate", "user.delete", "audit.read".
  key         String   @unique
  module      String
  action      String
  description String?
  /// Exercising a sensitive permission is always written to the audit log.
  isSensitive Boolean  @default(false)

  roles       RolePermission[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @db.Uuid
  role         Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  grantedAt    DateTime @default(now())
  grantedById  String?  @db.Uuid

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id           String @id @default(uuid()) @db.Uuid
  userId       String @db.Uuid
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId       String @db.Uuid
  role         Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  assignedAt   DateTime @default(now())
  assignedById String?  @db.Uuid
  expiresAt    DateTime?
  revokedAt    DateTime?
  revokedById  String?  @db.Uuid

  @@unique([userId, roleId])
  @@index([userId])
  @@map("user_roles")
}

/// Limits a user to specific branches. A user with no scope rows sees every
/// branch - that is how Super Admin and HR Admin are configured.
model UserScope {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId  String @db.Uuid
  branch    Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, branchId])
  @@map("user_scopes")
}

model RefreshToken {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the token. The raw token is never stored.
  tokenHash      String   @unique
  /// Rotation family. Re-use of a rotated token revokes the whole family.
  familyId       String   @db.Uuid
  userAgent      String?
  ipAddress      String?
  expiresAt      DateTime
  revokedAt      DateTime?
  revokedReason  String?
  replacedByHash String?

  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model LoginHistory {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String?  @db.Uuid
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Recorded even when no such user exists, so credential probing is visible.
  emailTried    String
  success       Boolean
  failureReason String?
  mfaUsed       Boolean  @default(false)
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([emailTried, createdAt])
  @@map("login_history")
}

// ---------------------------------------------------------------------------
//  ASSET CATALOGUE
//  Headphones, lockers, CUG SIMs and workstations are all assets. Each gets a
//  category plus an optional typed detail table for its own attributes, so
//  reporting stays uniform while the specifics stay strongly typed.
// ---------------------------------------------------------------------------

model AssetCategory {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  parentId    String?  @db.Uuid
  parent      AssetCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    AssetCategory[] @relation("CategoryTree")

  /// Prefix used when auto-generating asset tags, e.g. "LPT" -> LPT-1001.
  tagPrefix          String?
  requiresSerial     Boolean @default(true)
  /// Consumables are tracked by quantity in StockItem, not one row per unit.
  isConsumable       Boolean @default(false)
  defaultLifespanMonths Int?
  depreciationRatePct   Decimal? @db.Decimal(5, 2)
  /// JSON-schema describing the extra spec fields shown in the UI for this
  /// category. Lets new asset types be added with no code change.
  specSchema         Json    @default("{}")

  assets      Asset[]
  stockItems  StockItem[]

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid
  deletedById String?  @db.Uuid

  @@index([deletedAt])
  @@map("asset_categories")
}

model Vendor {
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @unique
  name           String
  contactPerson  String?
  phone          String?
  email          String?
  gstin          String?
  address        String?
  /// SUPPLIER | SERVICE | BOTH
  vendorType     String   @default("BOTH")
  rating         Int?
  notes          String?

  assets         Asset[]
  repairTickets  RepairTicket[]
  purchaseOrders PurchaseOrder[]

  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?
  createdById    String?  @db.Uuid
  updatedById    String?  @db.Uuid
  deletedById    String?  @db.Uuid

  @@map("vendors")
}

model PurchaseOrder {
  id           String   @id @default(uuid()) @db.Uuid
  poNumber     String   @unique
  vendorId     String?  @db.Uuid
  vendor       Vendor?  @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  poDate       DateTime? @db.Date
  invoiceNo    String?
  invoiceDate  DateTime? @db.Date
  totalAmount  Decimal? @db.Decimal(14, 2)
  currency     String   @default("INR")
  attachmentId String?  @db.Uuid
  notes        String?

  assets       Asset[]

  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?
  createdById  String?  @db.Uuid
  updatedById  String?  @db.Uuid
  deletedById  String?  @db.Uuid

  @@map("purchase_orders")
}

model Asset {
  id             String   @id @default(uuid()) @db.Uuid
  /// Human-readable tag printed on the sticker, e.g. LPT-1001. Never reused.
  assetTag       String   @unique
  serialNumber   String?
  /// Stable payload encoded in the printed QR sticker.
  qrCode         String?  @unique

  categoryId     String   @db.Uuid
  category       AssetCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  make           String?
  model          String?
  /// Category-specific attributes validated against AssetCategory.specSchema.
  specs          Json     @default("{}")

  status         AssetStatus    @default(IN_STOCK)
  condition      AssetCondition @default(UNKNOWN)
  ownership      OwnershipType  @default(OWNED)

  branchId       String?  @db.Uuid
  branch         Branch?  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  locationId     String?  @db.Uuid
  location       Location? @relation(fields: [locationId], references: [id], onDelete: Restrict)

  /// Denormalised cache of the ACTIVE allocation's holder, maintained by
  /// AllocationService inside the same transaction. Always derivable from
  /// asset_allocations - kept only so list screens avoid a join.
  currentHolderEmployeeId String? @db.Uuid
  currentAllocationId     String? @db.Uuid

  vendorId       String?  @db.Uuid
  vendor         Vendor?  @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  purchaseOrderId String? @db.Uuid
  purchaseOrder  PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  purchaseDate   DateTime? @db.Date
  purchaseCost   Decimal?  @db.Decimal(14, 2)
  currency       String    @default("INR")
  warrantyEndsAt DateTime? @db.Date
  amcVendorId    String?   @db.Uuid
  amcEndsAt      DateTime? @db.Date
  expectedLifeMonths Int?

  /// Accessories/components: a docking station belongs to a laptop.
  parentAssetId  String?  @db.Uuid
  parentAsset    Asset?   @relation("AssetComponents", fields: [parentAssetId], references: [id], onDelete: Restrict)
  components     Asset[]  @relation("AssetComponents")

  notes          String?

  allocations      AssetAllocation[]
  events           AssetEvent[]
  repairTickets    RepairTicket[]
  damageReports    DamageReport[]
  attachments      Attachment[]
  auditFindings    PhysicalAuditLine[]
  headphoneDetail  HeadphoneDetail?
  lockerDetail     Locker?
  cugDetail        CugConnection?
  workstationDetail Workstation?

  sourceType     SourceType @default(MANUAL)
  sourceRef      String?
  externalRefs   Json     @default("{}")

  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?
  createdById    String?  @db.Uuid
  updatedById    String?  @db.Uuid
  deletedById    String?  @db.Uuid
  /// Only a Super Admin may set this, and only through an approved request.
  archivedAt     DateTime?
  archiveReason  String?

  @@index([categoryId, status])
  @@index([branchId, locationId])
  @@index([serialNumber])
  @@index([currentHolderEmployeeId])
  @@index([status])
  @@index([deletedAt])
  @@index([warrantyEndsAt])
  @@map("assets")
}

// ---------------------------------------------------------------------------
//  ALLOCATION & LIFETIME HISTORY
//  Allocation rows are never deleted. Returning an asset closes the row and
//  opens nothing; the full chain of custody stays queryable forever.
// ---------------------------------------------------------------------------

model AssetAllocation {
  id            String   @id @default(uuid()) @db.Uuid
  assetId       String   @db.Uuid
  asset         Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)

  holderType    AllocationHolderType @default(EMPLOYEE)
  employeeId    String?  @db.Uuid
  employee      Employee? @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  /// Set when holderType is DEPARTMENT / WORKSTATION / LOCATION / VENDOR.
  holderRefId   String?  @db.Uuid
  holderLabel   String?

  status        AllocationStatus @default(ACTIVE)
  allocatedAt   DateTime
  allocatedById String?  @db.Uuid
  /// Condition recorded at hand-over and at return - the basis for damage
  /// recovery conversations.
  conditionOut  AssetCondition @default(GOOD)
  expectedReturnAt DateTime?

  returnedAt    DateTime?
  returnedToById String? @db.Uuid
  conditionIn   AssetCondition?
  returnRemarks String?

  /// Signed hand-over acknowledgement (scan or e-sign payload).
  acknowledgedAt DateTime?
  acknowledgementRef String?

  remarks       String?
  attachments   Attachment[]

  sourceType    SourceType @default(MANUAL)
  sourceRef     String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String?  @db.Uuid
  updatedById   String?  @db.Uuid
  /// Allocations are historical record - soft delete exists only so a
  /// mis-keyed row can be voided, and it still stays visible in history.
  deletedAt     DateTime?
  deletedById   String?  @db.Uuid
  voidReason    String?

  @@index([assetId, status])
  @@index([employeeId, status])
  @@index([allocatedAt])
  @@map("asset_allocations")
}

/// Append-only. Nothing in the application is permitted to UPDATE or DELETE a
/// row here - enforced by a database trigger (see migrations/manual).
model AssetEvent {
  id          String   @id @default(uuid()) @db.Uuid
  assetId     String   @db.Uuid
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)

  eventType   AssetEventType
  occurredAt  DateTime @default(now())
  /// Free-text line rendered on the asset timeline in the UI.
  summary     String
  fromValue   Json?
  toValue     Json?
  /// Whatever caused it: allocation id, repair ticket id, sync run id...
  refType     String?
  refId       String?  @db.Uuid

  actorUserId String?  @db.Uuid
  actorName   String?
  ipAddress   String?

  createdAt   DateTime @default(now())

  @@index([assetId, occurredAt])
  @@index([eventType])
  @@map("asset_events")
}

// ---------------------------------------------------------------------------
//  REPAIRS & DAMAGE
// ---------------------------------------------------------------------------

model RepairTicket {
  id             String   @id @default(uuid()) @db.Uuid
  ticketNo       String   @unique
  assetId        String   @db.Uuid
  asset          Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)

  reportedById   String?  @db.Uuid
  reportedBy     Employee? @relation("RepairReporter", fields: [reportedById], references: [id], onDelete: Restrict)
  reportedAt     DateTime @default(now())
  faultCategory  String?
  faultDescription String

  status         RepairStatus @default(REPORTED)
  priority       String   @default("NORMAL")

  vendorId       String?  @db.Uuid
