// ---------------------------------------------------------------------------
//  REQUESTS & APPROVAL WORKFLOW
//  Request -> Manager -> Admin -> commit. Nothing sensitive is written to the
//  master tables until every required step is APPROVED.
// ---------------------------------------------------------------------------

model AssetRequest {
  id            String   @id @default(uuid()) @db.Uuid
  requestNo     String   @unique
  requestType   RequestType
  status        RequestStatus @default(DRAFT)

  requestedById String   @db.Uuid
  requestedBy   Employee @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  departmentId  String?  @db.Uuid
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  categoryId    String?  @db.Uuid
  quantity      Int      @default(1)
  justification String?
  neededBy      DateTime? @db.Date
  priority      String   @default("NORMAL")

  /// Set once fulfilled, so the request links to what was actually handed over.
  fulfilledAssetIds Json  @default("[]")
  fulfilledAt   DateTime?
  fulfilledById String?  @db.Uuid

  approvalRequestId String? @unique @db.Uuid
  approvalRequest   ApprovalRequest? @relation(fields: [approvalRequestId], references: [id], onDelete: SetNull)

  attachments   Attachment[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
  createdById   String?  @db.Uuid
  updatedById   String?  @db.Uuid
  deletedById   String?  @db.Uuid

  @@index([status, requestType])
  @@index([requestedById])
  @@map("asset_requests")
}

/// A pending mutation held in escrow. `payload` is the exact change that will
/// be applied once every step approves - it is applied by the server, never
/// re-submitted by the client, so an approved change cannot be tampered with.
model ApprovalRequest {
  id            String   @id @default(uuid()) @db.Uuid
  requestNo     String   @unique
  changeType    ChangeRequestType
  status        ApprovalStatus @default(PENDING)

  /// Table + row this affects. Null for bulk operations.
  targetTable   String?
  targetId      String?  @db.Uuid
  targetLabel   String?

  /// Machine-applicable diff: { before: {...}, after: {...}, op: "..." }
  payload       Json
  reason        String
  riskNote      String?
  affectedCount Int      @default(1)

  raisedById    String   @db.Uuid
  raisedByName  String
  raisedAt      DateTime @default(now())

  steps         ApprovalStep[]
  assetRequest  AssetRequest?

  decidedAt     DateTime?
  appliedAt     DateTime?
  applyError    String?
  expiresAt     DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, changeType])
  @@index([targetTable, targetId])
  @@map("approval_requests")
}

model ApprovalStep {
  id          String   @id @default(uuid()) @db.Uuid
  requestId   String   @db.Uuid
  request     ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  stage       ApprovalStage
  sequence    Int
  status      ApprovalStatus @default(PENDING)

  /// Either a specific approver or "anyone holding this role".
  assignedUserId String? @db.Uuid
  assignedRoleKey String?

  decidedById String?  @db.Uuid
  decidedBy   User?    @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?
  comment     String?
  ipAddress   String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([requestId, sequence])
  @@index([status, assignedRoleKey])
  @@map("approval_steps")
}

// ---------------------------------------------------------------------------
//  PHYSICAL AUDIT (stock-take)
// ---------------------------------------------------------------------------

model PhysicalAudit {
